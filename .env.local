# Local Development Environment Variables
# 
# IMPORTANT: Add your API keys below to test the application locally
#
# Get your StockData.org token at: https://www.stockdata.org/
# (Free tier: 100 API calls per day - RECOMMENDED)
STOCKDATA_ORG_API_TOKEN=

# Get your Alpha Vantage key at: https://www.alphavantage.co/support/#api-key
# (Free tier: 25 API calls per day - FALLBACK)
ALPHA_VANTAGE_API_KEY=

# INSTRUCTIONS:
# 1. Sign up for at least one of the APIs above
# 2. Copy your API key/token
# 3. Paste it after the = sign (no quotes needed)
# 4. Save this file
# 5. Run: npm run dev:local
# 6. Access the app at: http://localhost:8888
